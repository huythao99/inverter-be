# API URL for the backend
# For development:
VITE_API_URL=http://localhost:3000
# For production:
# VITE_API_URL=https://giabao-inverter.com

# MQTT WebSocket URL for real-time data: nginx /mqtt -> mosquitto
# websocket listener (port 9001), over TLS. Defaults to this when unset.
VITE_MQTT_WS_URL=wss://giabao-inverter.com/mqtt

# MQTT credentials: none here - the CMS gets a read-only account from
# GET /api/cms/mqtt-credentials after admin login.
